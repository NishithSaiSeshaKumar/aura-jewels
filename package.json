  {
  "name": "aura-jewels",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "start:web": "npm run start --workspace=apps/web",
    "start:api": "npm run dev --workspace=services/api",
    "build:web": "npm run build --workspace=apps/web",
    "deploy:api": "npm run deploy --workspace=services/api"
  },
  "devDependencies": {
  "@angular-devkit/build-angular": "^19.0.0",
  "@angular/cli": "^19.0.0",
  "@angular/compiler-cli": "^19.0.0",
  "@tailwindcss/postcss": "^4.0.0",
  "postcss": "^8.5.0",
  "tailwindcss": "^4.0.0",
  "typescript": "~5.5.2"
}
}
